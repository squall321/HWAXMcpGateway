gateway_config.json
.venv/
__pycache__/
*.pyc
audit.jsonl
provision.env
gateway.log
gateway.pid
gateway_config.json.bak
gateway_config.json.bak.*
gateway.log-*
gateway_config.json.bak-*

# data-migrate 가 남기는 옛 경로 원본(유예 뒤 사람이 지운다). 미추적이면 deploy-all 의 git stash -u 가 치운다
*.pre-move-*
# 포털 권한 정책 캐시(포털이 잠깐 죽어도 직전 정책으로 돈다) — 실행 산출물
.access_policy_cache.json
# 외부 연결 선언 캐시(포털이 늦게 떠도 첫 카탈로그에 선언 백엔드를 넣는다 — 토큰은 없다, 0600) — 실행 산출물(HWAXPortal docs/ext-connect GW17)
.conn_registry_cache.json
# search_tools 평가 러너의 로컬 파일 — 카탈로그 스냅샷(내부 도구 설명 전문)·실사용 질의는 추적하지 않는다(tool_search_eval/README.md)
tool_search_eval/*.local.*
# 검색 손잡이의 박스 덧씌우기(HWAXPortal docs/request-1029 E-7) — 박스에서 커밋 없이 튜닝한다. 무시 목록에 없으면 deploy-all · update-all 의
# git stash -u 가 치운다
search_tuning.local.json
# 루틴 단계 읽기 목록의 박스 덧씌우기(HWAXPortal docs/analysis-routines R3 리뷰 #0) — read_tools.json 과 같은 꼴, 박스에서 커밋 없이 더한다.
# 무시 목록에 없으면 deploy-all · update-all 의 git stash -u 가 치운다
read_tools.local.json
# 서비스 PAT 작업별 허용 목록(HWAXPortal docs/core-link SRC-13) — 박스마다 운영자가 쓴다. 무시 목록에 없으면 deploy-all · update-all 의
# git stash -u 가 치운다
service_tools.local.json
# 앱 키 표의 박스 덧씌우기(HWAXPortal docs/request-1117 GW-05) — 환경(default_env · apps.<키>.env) · 정본 여부는 박스의 사실이다. 무시 목록에 없으면
# deploy-all · update-all 의 git stash -u 가 치운다
app_keys.local.json
# 적재 경로 선언의 박스 덧씌우기(HWAXPortal docs/request-1117 GW-01 — 공개만) — 점검 주소(check_base) · 박스에서만 쓰는 경로는 박스의 사실이다.
# 무시 목록에 없으면 deploy-all · update-all 의 git stash -u 가 치운다
ingest_routes.local.json
# 이용 통계 창구(/usage-rollup)가 감사 원장을 날마다 접어 두는 표(HWAXPortal docs/ops-dashboard M2) — 원장이 리포 안에 있는 박스에서만 여기 생긴다
# (데이터 루트가 있으면 원장 곁). 사람별 줄이 든다. 무시 목록에 없으면 deploy-all · update-all 의 git stash -u 가 치운다
usage-rollup.sqlite*
# 상호작용 수집 창고(HWAXPortal docs/interaction-data contract §3) — 기본은 체크아웃 밖(데이터 루트의 interaction_spool · 리포 옆
# <리포>-interaction_spool)이다. GATEWAY_INTERACTION_SPOOL_DIR 를 리포 안 상대 경로로 잡은 박스에서 원문이 커밋 · stash 되지 않게
interaction_spool/
# 목적 묶음 표의 박스 덧씌우기(HWAXPortal docs/mcp-modernize M3) — 검색 손잡이 · 코어 어휘표 덧씌우기와 같은 꼴(merge patch), 박스에서 커밋 없이
# 목적을 더하고 고친다. 무시 목록에 없으면 deploy-all · update-all 의 git stash -u 가 치운다
tool_purposes.local.json
# 채택 셈 원장(HWAXPortal docs/mcp-modernize M0 · M3 — 보기 · prompts · 자원 읽기의 날마다 수) — 이용 통계 표 곁에 생긴다. 원장이 리포 안이면 리포 안이다
usage-adoption.sqlite*
# 도구 영역 표의 박스 덧씌우기(HWAXPortal docs/request-1125 CT-02) — dev 에 없는 사내 앱의 영역은 그 앱 주인이 정하고 박스가 커밋 없이 적는다. 무시 목록에
# 없으면 deploy-all · update-all 의 git stash -u 가 치운다
tool_areas.local.json
